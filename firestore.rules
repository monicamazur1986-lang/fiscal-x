
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // FUNÇÕES AUXILIARES DE SEGURANÇA
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRoot() {
      return isAuthenticated() && (
        request.auth.token.email == 'app.fiscalx@gmail.com' ||
        getUserData().role == 'root'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || isRoot()
      );
    }

    // Verifica se o documento pertence ao mesmo município do usuário
    function belongsToMyMunicipio(data) {
      return isAuthenticated() && (
        isRoot() || data.municipioId == getUserData().municipioId
      );
    }

    // REGRAS POR COLEÇÃO

    // Marca do sistema deve ser pública para aparecer no Login
    match /configuracoes/global {
      allow read: if true;
      allow write: if isRoot();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isRoot() || (isAdmin() && resource.data.municipioId == getUserData().municipioId)
      );

      // Auto-cadastro (solicitar-acesso) grava o próprio doc direto do client
      // (registerWithEmailPassword/rootProfile em use-auth.tsx) — sem
      // restringir os campos aqui, bastava um setDoc manual (devtools) pro
      // próprio usuário nascer com role:'root', isAuthorized:true e
      // status:'approved', pulando toda a aprovação do gestor. Isso não
      // depende do client: só é bloqueado aqui, nas regras.
      // Nenhum fluxo do app cria doc de OUTRO usuário (nem admin faz isso —
      // ver admin/usuarios/page.tsx: só updateDoc em conta já existente), por
      // isso não existe mais um branch "isAdmin() cria para outro uid" aqui.
      allow create: if isAuthenticated() && (
        isRoot() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role in ['admin', 'fiscal'] &&
          request.resource.data.isAuthorized == false &&
          request.resource.data.status == 'pending'
        )
      );

      // Mesmo raciocínio pro update: sem travar os campos, um updateDoc
      // manual no próprio doc (OU no de outro usuário do mesmo município,
      // pelo branch de admin) bastava pra promover role a 'root' ou mudar
      // municipioId — nada na UI de admin/usuarios/page.tsx jamais toca
      // nesses dois campos, só em isAuthorized/status/fiscalCode/adminFeedback.
      allow update: if isAuthenticated() && (
        isRoot() ||
        (
          isAdmin() &&
          resource.data.municipioId == getUserData().municipioId &&
          request.resource.data.municipioId == resource.data.municipioId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAuthorized', 'status', 'fiscalCode', 'adminFeedback', 'updatedAt'])
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'fcmTokens'])
        )
      );

      allow delete: if isRoot() || (isAdmin() && resource.data.municipioId == getUserData().municipioId);
    }
    
    match /adminRequests/{requestId} {
      allow create: if isAuthenticated();
      allow read, update: if isRoot();
    }
    
    // Pastas de organização (Documentos e Docfacil), isoladas por município —
    // mesmo padrão de docfacilModelos.
    match /folders/{id} {
      allow read: if belongsToMyMunicipio(resource.data);
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      // municipioId travado no update: sem isso, o próprio criador podia
      // "mudar de município" um documento já existente (escapar da
      // supervisão do próprio gestor ou plantar algo no espaço de outro).
      allow update: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()) && request.resource.data.municipioId == resource.data.municipioId)
      );
      allow delete: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()))
      );
    }

    match /biblioteca/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Manual/Central de Ajuda (perguntas e respostas) — global, igual pra
    // todo mundo, sem isolamento por município.
    match /faq/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Índice local dos dados públicos da ANVISA (sincronizado por um cron via
    // Admin SDK, que ignora estas regras). Cliente só lê; nunca escreve.
    match /anvisaIndex/{datasetKey} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /registros/{id} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
    
    match /intimacoes/{id} {
      allow read: if isAuthenticated() && (
        isRoot() || 
        (isAdmin() && resource.data.municipioId == getUserData().municipioId) ||
        (resource.data.createdBy == request.auth.uid)
      );
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      // municipioId travado no update — mesmo motivo de folders/{id} acima:
      // impede o dono (ou um admin) de reatribuir a autuação pra outro
      // município via update, o que furaria o isolamento por tenant.
      allow update: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()) && request.resource.data.municipioId == resource.data.municipioId)
      );
      allow delete: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()))
      );
    }

    match /chamados/{id} {
      allow read: if isAuthenticated() && (
        isRoot() ||
        (isAdmin() && resource.data.municipioId == getUserData().municipioId) ||
        (resource.data.createdBy == request.auth.uid)
      );
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      // Só quem abriu o chamado ou um gestor do mesmo município (ou root) pode
      // atualizar (responder, mudar status) — mesmo isolamento por município
      // já usado em intimações e inspeções.
      allow update: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()) && request.resource.data.municipioId == resource.data.municipioId)
      );
    }

    // DOCFACIL — modelos e documentos oficiais (ofício/memorando/circular),
    // isolados por município. Leitura aberta a todo o município (modelos são
    // pra reaproveitar em equipe); escrita só de quem criou ou de um gestor.
    match /docfacilModelos/{id} {
      allow read: if belongsToMyMunicipio(resource.data);
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      allow update: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()) && request.resource.data.municipioId == resource.data.municipioId)
      );
      allow delete: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()))
      );
    }

    match /docfacilDocumentos/{id} {
      allow read: if belongsToMyMunicipio(resource.data);
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      allow update: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()) && request.resource.data.municipioId == resource.data.municipioId)
      );
      allow delete: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.createdBy == request.auth.uid || isAdmin()))
      );
    }

    // Exemplos de rascunhos do Fiscal AI que o próprio fiscal decidiu usar
    // (exportou pro formulário de autuação) — servem de referência de estilo
    // pra Claude em casos novos parecidos. Isolado por município: o relato
    // pode citar nome de estabelecimento, CNPJ etc.
    match /fiscalAiExemplos/{id} {
      allow read: if belongsToMyMunicipio(resource.data);
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      allow update, delete: if isRoot() || (isAdmin() && resource.data.municipioId == getUserData().municipioId);
    }

    match /autoridades/{id} {
      allow read: if belongsToMyMunicipio(resource.data);
      allow write: if isAdmin() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
    }

    match /inspecoes/{id} {
      allow read: if isAuthenticated() && (
        isRoot() ||
        (isAdmin() && resource.data.municipioId == getUserData().municipioId) ||
        (resource.data.fiscalId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (isRoot() || request.resource.data.municipioId == getUserData().municipioId);
      allow update: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.fiscalId == request.auth.uid || isAdmin()) && request.resource.data.municipioId == resource.data.municipioId)
      );
      allow delete: if isAuthenticated() && (
        isRoot() || (resource.data.municipioId == getUserData().municipioId && (resource.data.fiscalId == request.auth.uid || isAdmin()))
      );
    }

    // Configuração de marca/identidade de cada município (logo, secretaria, etc.)
    match /municipios/{municipioId}/config/{configId} {
      allow read: if isAuthenticated() && (isRoot() || municipioId == getUserData().municipioId);
      allow write: if isRoot() || (isAdmin() && municipioId == getUserData().municipioId);
    }

    // Contador de numeração de autuações por município/ano (incremento atômico)
    match /municipios/{municipioId}/counters/{year} {
      allow read, write: if isAuthenticated() && (isRoot() || municipioId == getUserData().municipioId);
    }

    // Mural/chat interno de cada município
    match /municipios/{municipioId}/topics/{topicId}/messages/{messageId} {
      allow read, create, update: if isAuthenticated() && (isRoot() || municipioId == getUserData().municipioId);
      allow delete: if isRoot();

      match /comments/{commentId} {
        allow read, create: if isAuthenticated() && (isRoot() || municipioId == getUserData().municipioId);
        allow update, delete: if isRoot();
      }
    }

    match /{document=**} {
      allow read, write: if isRoot();
    }
  }
}
