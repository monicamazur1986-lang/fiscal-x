rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Espelha getUserData()/isRoot() do firestore.rules — Storage Rules v2
    // consegue ler o Firestore (cross-service rules) pra tomar a mesma
    // decisão de autorização em vez de confiar só em isAuthenticated().
    function myUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isRoot() {
      return isAuthenticated() && (
        request.auth.token.email == 'app.fiscalx@gmail.com' ||
        myUserData().role == 'root'
      );
    }

    function belongsToMyMunicipio(municipioId) {
      return isAuthenticated() && (isRoot() || myUserData().municipioId == municipioId);
    }

    // Logomarca global do sistema (aparece na tela de login) - pública para leitura,
    // mas só root grava (mesmo papel exigido por updateSystemLogo no app).
    match /system/{allPaths=**} {
      allow read: if true;
      allow write: if isRoot();
    }

    // Fotos de perfil enviadas via /api/upload (Admin SDK) - leitura pública, escrita só pelo servidor
    match /user-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Identidade visual municipal (brasão etc.) — path já carrega o
    // município; antes qualquer autenticado lia/escrevia em qualquer
    // município (bastava saber o caminho). Agora exige pertencer a ele.
    match /municipios/{municipioId}/{allPaths=**} {
      allow read, write: if belongsToMyMunicipio(municipioId);
    }

    // Fotos do mural — nome do arquivo sempre começa com o uid de quem
    // enviou (ver recados/page.tsx); só o dono (ou root) pode escrever.
    // Leitura fica aberta a qualquer autenticado (mural é só leitura ampla
    // dentro do próprio município no Firestore; o Storage não sabe o
    // município do arquivo, só o dono).
    match /recados/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (fileName.matches(request.auth.uid + '_.*') || isRoot());
    }

    // Fotos de inspeção — path já carrega o uid do fiscal; só o próprio
    // dono (ou root) pode escrever. Antes, qualquer autenticado conseguia
    // escrever na pasta de qualquer outro fiscal.
    match /inspecoes/{uid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == uid || isRoot());
    }

    // decretos/{timestamp}_{cpf} não carrega uid nem município no caminho —
    // enviado durante o auto-cadastro (conta recém-criada em
    // solicitar-acesso/page.tsx, antes do doc em users/ estar garantido),
    // por isso a escrita continua exigindo só "estar autenticado" (não dá
    // pra restringir por dono sem mudar a estrutura do caminho). Leitura,
    // porém, nenhuma tela do app usa — nada exibe/baixa o decreto depois do
    // upload — então fica restrita ao root, para não deixar qualquer conta
    // autenticada (de outro fiscal, outro município) ler ou baixar o
    // decreto/CPF de nomeação de terceiros.
    match /decretos/{allPaths=**} {
      allow create: if isAuthenticated();
      allow read: if isRoot();
      allow update, delete: if false;
    }

    // Anexos do PAS (assinatura, provas, PDF de relatório pronto etc.) — o
    // path já carrega o id do processo; espelha a mesma permissão de
    // leitura do documento em firestore.rules (dono, encaminhado,
    // compartilhado por autoridade, gestor do mesmo município, ou root).
    // Sem esta regra, TODA gravação aqui vinha negada e caía calada no
    // fallback de base64 dentro do próprio documento do Firestore — passava
    // batido numa assinatura pequena, mas um PDF de relatório nesse caminho
    // estourava o limite de 1 MiB por documento e a peça nunca terminava
    // de gravar (ver uploadArquivoPas em pas/[id]/page.tsx).
    function pasData(pasId) {
      return firestore.get(/databases/(default)/documents/pas/$(pasId)).data;
    }
    function podeAcessarPas(pasId) {
      return isAuthenticated() && (
        isRoot() ||
        (myUserData().role == 'admin' && pasData(pasId).municipioId == myUserData().municipioId) ||
        pasData(pasId).createdBy == request.auth.uid ||
        pasData(pasId).responsavelAtualUid == request.auth.uid ||
        (request.auth.uid in pasData(pasId).get('compartilhadoCom', []))
      );
    }
    match /pas/{pasId}/{allPaths=**} {
      allow read, write: if podeAcessarPas(pasId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
